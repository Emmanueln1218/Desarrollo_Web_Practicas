            "body": {
              "mode": "raw",
              "raw": "{\n  \"client\": {\"id\": 1},\n  \"plate\": \"ABC-123\",\n  \"brand\": \"Honda\",\n  \"model\": \"CB500\",\n  \"year\": 2022\n}"
            }
          }
        },
        {
          "name": "List Motorcycles",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/api/motorcycles", "host": ["{{base_url}}"], "path": ["api", "motorcycles"]}
          }
        }
      ]
    },
