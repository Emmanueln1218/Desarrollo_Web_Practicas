{
  "info": {
    "name": "MotoCitas API",
    "description": "Colección de APIs de MotoCitas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Clients",
      "item": [
        {
          "name": "Create Client",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": {"raw": "{{base_url}}/api/clients", "host": ["{{base_url}}"], "path": ["api", "clients"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan Pérez\",\n  \"email\": \"juan@example.com\",\n  \"phone\": \"3001234567\",\n  \"document\": \"12345678\"\n}"
            }
          }
        },
        {
          "name": "List Clients",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/api/clients", "host": ["{{base_url}}"], "path": ["api", "clients"]}
          }
        },
        {
          "name": "Search Clients",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/api/clients?q=Juan", "host": ["{{base_url}}"], "path": ["api", "clients"], "query": [{"key": "q", "value": "Juan"}]}
          }
        }
      ]
    },
    {
